# NEXUS OPS — server environment
# ----------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit real credentials — `.env` is
# gitignored. These are read by the server-side Notion proxy only and are
# never prefixed with VITE_, so they are never inlined into the client bundle.
# ----------------------------------------------------------------------

# Notion internal integration secret. Required for LIVE mode.
# Create one at https://www.notion.so/my-integrations then share a page with it.
NOTION_API_KEY=

# Legacy alias — if your environment already uses NOTION_TOKEN, keep using it.
# NOTION_TOKEN=

# The page the integration was shared with. NEXUS creates/maps its databases
# under this page.
NOTION_PARENT_PAGE_ID=

# Optional: point NEXUS at pre-existing databases instead of provisioning new
# ones. One variable per database key, e.g.:
# NOTION_DB_EVENTS=
# NOTION_DB_SESSIONS=
# NOTION_DB_TEAMS=
# NOTION_DB_MEMBERS=
# NOTION_DB_VOLUNTEERS=
# NOTION_DB_PARTICIPANTS=
# NOTION_DB_TASKS=
# NOTION_DB_RESOURCES=
# NOTION_DB_INCIDENTS=
# NOTION_DB_DEPENDENCIES=
# NOTION_DB_COMMUNICATIONS=
# NOTION_DB_KNOWLEDGE=

# Demo transport: when set to 1 and NO real key is present, the server runs a
# deterministic in-memory Notion so READ/WRITE/UPDATE can be exercised without
# credentials. The UI labels the whole session DEMO NOTION MODE. Never a
# substitute for a real connection.
NEXUS_MOCK_NOTION=0
